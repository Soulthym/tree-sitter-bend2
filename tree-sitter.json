{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "bend2",
      "camelcase": "Bend2",
      "title": "Bend2",
      "scope": "source.bend2",
      "file-types": [
        "bend"
      ],
      "injection-regex": "^(bend|bend2)$",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "class-name": "TreeSitterBend2"
    }
  ],
  "metadata": {
    "version": "0.3.0",
    "license": "MIT",
    "description": "Bend2 tree-sitter-parser",
    "authors": [
      {
        "name": "Thybault Alabarbe",
        "email": "thybault.alabarbe@gmail.com",
        "url": "https://github.com/Soulthym/"
      }
    ],
    "links": {
      "repository": "https://github.com/Soulthym/tree-sitter-bend2",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}